# === Verilənlər bazası ===
POSTGRES_USER=taxpro
POSTGRES_PASSWORD=taxpro
POSTGRES_DB=taxpro
POSTGRES_PORT=5432
BACKEND_PORT=8000

# === Backend konfiqurasiyası ===
# Docker daxilində: db / Yerli işləmə: localhost
DB_URL=postgresql+asyncpg://taxpro:taxpro@localhost:5432/taxpro
# Vergül ilə ayrılmış originlər. Chrome Extension üçün:
CORS_ORIGINS=chrome-extension://*,http://localhost:3000,http://localhost:8000

# === Logging ===
LOG_LEVEL=INFO

# === Mühit ===
APP_ENV=development
