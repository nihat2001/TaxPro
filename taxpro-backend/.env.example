# === Verilənlər bazası ===
POSTGRES_USER=taxpro
POSTGRES_PASSWORD=taxpro
POSTGRES_DB=taxpro
POSTGRES_PORT=5432
BACKEND_PORT=8000

# === Backend konfiqurasiyası ===
# Docker daxilində: db / Yerli işləmə: localhost
DB_URL=postgresql+asyncpg://taxpro:taxpro@localhost:5432/taxpro
# Fernet açarı: PowerShell ilə yaradın:
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b).Replace('+','-').Replace('/','_')
ENCRYPTION_KEY=
# Vergül ilə ayrılmış originlər. Chrome Extension üçün:
CORS_ORIGINS=chrome-extension://*,http://localhost:3000,http://localhost:8000

# === LLM / AI konfiqurasiyası ===
# Provayder: openai və ya anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Logging ===
LOG_LEVEL=INFO

# === Mühit ===
# development: DB əlçatmaz olsa MemorySaver fallback (yalnız yerli testlər üçün)
# production: Postgres checkpointer olmasa app başlamaz (fail-fast)
APP_ENV=development
